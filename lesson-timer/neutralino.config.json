{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "kr.edu.lessontimer",
  "version": "1.2.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "logging": {
    "enabled": false,
    "writeToLogFile": false
  },
  "nativeAllowList": [
    "app.*",
    "window.*",
    "os.getPath",
    "filesystem.readFile",
    "filesystem.writeFile",
    "filesystem.createDirectory",
    "filesystem.writeBinaryFile",
    "os.showSaveDialog",
    "os.execCommand"
  ],
  "globalVariables": {},
  "modes": {
    "window": {
      "title": "수업 타이머",
      "width": 1280,
      "height": 820,
      "minWidth": 260,
      "minHeight": 120,
      "center": true,
      "fullScreen": false,
      "alwaysOnTop": false,
      "icon": "/resources/icon.png",
      "enableInspector": false,
      "borderless": false,
      "maximize": false,
      "hidden": false,
      "resizable": true,
      "exitProcessOnClose": true,
      "webviewArgs": "--autoplay-policy=no-user-gesture-required --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
    }
  },
  "cli": {
    "binaryName": "LessonTimer",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "6.8.0",
    "clientVersion": "6.8.0"
  }
}